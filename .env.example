# ──────────────────────────────────────────────────────────────
# Mehfil Couture — environment configuration
# Copy to `.env.local` and fill in. Never commit real secrets.
# Anything prefixed VITE_ is bundled into the public site, so
# only put PUBLIC business details here — never API secrets.
# ──────────────────────────────────────────────────────────────

# Public site URL (used for canonical / Open Graph / structured data)
VITE_SITE_URL=https://www.example.com

# WhatsApp Business number, digits only with country code (e.g. 91XXXXXXXXXX).
# NOT publicly verified yet — while empty, enquiries fall back to Instagram DM.
VITE_WHATSAPP_NUMBER=

# Public phone & email shown in the footer / contact block (optional).
VITE_PUBLIC_PHONE=
VITE_PUBLIC_EMAIL=

# Optional: endpoint that accepts POST JSON for styling-appointment requests
# (e.g. a Formspree / Basin / serverless function URL). When empty, the form
# prepares a prefilled WhatsApp / Instagram message instead.
VITE_APPOINTMENT_ENDPOINT=

# Optional: endpoint that accepts POST JSON { email, consent } for the launch list
# (e.g. Mailchimp/Brevo/Klaviyo via a serverless function). When empty, the form
# validates but clearly tells the visitor nothing was stored.
VITE_NEWSLETTER_ENDPOINT=

# Analytics: set to "true" ONLY after a consent-aware provider (e.g. GA4 via GTM)
# is configured. Events are pushed to window.dataLayer after visitor consent.
VITE_ANALYTICS_ENABLED=false
